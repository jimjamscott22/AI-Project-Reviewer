{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "mysql2": "^3.23.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
