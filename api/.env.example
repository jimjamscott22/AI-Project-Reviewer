# Copy to .env and adjust for your environment (Raspberry Pi in production).
PORT=8080
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=apr
DB_PASSWORD=apr
DB_NAME=apr

# Safe repository analysis limits. Paths are resolved by the API process.
REPO_WORK_ROOT=.review-work
REPO_CLONE_TIMEOUT_MS=120000
REPO_COMMAND_OUTPUT_BYTES=65536
ANALYSIS_TIMEOUT_MS=120000
ANALYSIS_MAX_FILES=5000
ANALYSIS_MAX_TOTAL_BYTES=26214400
ANALYSIS_MAX_FILE_BYTES=262144
REGISTRY_TIMEOUT_MS=3000
REGISTRY_MAX_PACKAGES=30
WORKER_POLL_MS=1000
# Optional absolute path to a separately pinned gitleaks binary.
GITLEAKS_PATH=
